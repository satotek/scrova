/target
/.direnv
# Throwaway clones and build dirs (some reference projects are not redistributable).
/.scratch/

# Build outputs of scripts/build-apple.sh
/apps/apple/ScrovaKit/ScrovaFFI.xcframework
/apps/apple/ScrovaKit/Sources/ScrovaKit/Generated/

# Build outputs of scripts/build-android.sh
/apps/android/app/src/main/jniLibs/
/apps/android/app/src/main/generated/kotlin/

# Generated by xcodegen from apps/apple/project.yml
/apps/apple/Scrova.xcodeproj/

# Local Last.fm credentials and signing team
/apps/apple/Config/Secrets.xcconfig

# SwiftPM / Xcode
.build/
.swiftpm/
xcuserdata/
DerivedData/

# Local notes that do not belong in the repository (e.g. competitor research)
/tmp/

# Android build outputs, and local.properties (SDK path, Last.fm credentials)
/apps/android/.gradle/
/apps/android/.kotlin/
/apps/android/.idea/
/apps/android/local.properties
/apps/android/**/build/
/apps/android/**/.cxx/
*.iml

# Windows (.NET / WinUI) build outputs
/apps/windows/**/bin/
/apps/windows/**/obj/
/apps/windows/.vs/
/apps/windows/**/*.user

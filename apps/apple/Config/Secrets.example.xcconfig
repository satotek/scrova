// Copy to Secrets.xcconfig in this directory (gitignored).
// Base.xcconfig includes that file after its ad-hoc defaults, so values here win.
//
// Leave the signing lines commented to keep ad-hoc signing (CODE_SIGN_IDENTITY=-).
// Uncomment all three together when DEVELOPMENT_TEAM is set; Automatic with an
// empty team fails the build.
//
// DEVELOPMENT_TEAM = ABCDE12345
// CODE_SIGN_STYLE = Automatic
// CODE_SIGN_IDENTITY = Apple Development

LASTFM_API_KEY =
LASTFM_SHARED_SECRET =

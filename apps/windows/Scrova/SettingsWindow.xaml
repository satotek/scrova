<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Scrova.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Placeholder: reachable from the main window, but nothing here is wired to the Rust core yet. -->
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Settings" />

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Last.fm account" />

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE77B;" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Not signed in" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Sign in to scrobble what you play."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="Sign in"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Coming soon" />
                </Grid>
            </Border>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="The Rust core isn't connected yet, so sign-in and scrobbling aren't available in this build."
                Severity="Informational" />
        </StackPanel>

        <Button
            x:Name="CloseButton"
            Grid.Row="2"
            MinWidth="96"
            HorizontalAlignment="Right"
            Click="OnCloseClick"
            Content="Close"
            Style="{StaticResource AccentButtonStyle}" />
    </Grid>
</Window>
